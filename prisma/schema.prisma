generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── JERARQUÍA DE NEGOCIO ────────────────────────────────────────────────────

model Local {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  puntosDeVenta   PuntoDeVenta[]
  compras         Compra[]
  ventas          Venta[]
  detallesCompra  DetalleCompra[]
  pagos           Pago[]
  flujoCajaManual FlujoCajaManual[]
  destinosRegla   DestinoRegla[]
  reglasOrigen    ReglaApertura[]  @relation("reglaOrigenLocal")

  @@map("locales")
}

model PuntoDeVenta {
  id      Int    @id @default(autoincrement())
  nombre  String
  localId Int

  local           Local             @relation(fields: [localId], references: [id])
  compras         Compra[]
  ventas          Venta[]
  pagos           Pago[]
  flujoCajaManual FlujoCajaManual[]
  destinosRegla   DestinoRegla[]
  reglasOrigen    ReglaApertura[]   @relation("reglaOrigenPdv")

  @@unique([nombre, localId])
  @@map("puntos_de_venta")
}

// ─── MAESTROS ────────────────────────────────────────────────────────────────

model RubroConceptoCaja {
  id                  Int     @id @default(autoincrement())
  codigo              String  @unique
  nombre              String
  calcRent            String?
  visibleEnDashboard  Boolean @default(true)
  visibleEnResultados Boolean @default(false)

  conceptosCaja ConceptoCaja[]

  @@map("rubros_concepto_caja")
}

// Visibilidad del bucket sintético "Sin Rubro" (compras sin rubro asignado): no existe como fila
// de RubroConceptoCaja, así que su toggle vive acá. Tabla de una sola fila (id = 1).
model SinRubroConfig {
  id                  Int     @id @default(1)
  visibleEnDashboard  Boolean @default(true)
  visibleEnResultados Boolean @default(false)

  @@map("sin_rubro_config")
}

model ConceptoCaja {
  id     Int     @id @default(autoincrement())
  codigo String  @unique
  nombre String
  tipo   String?
  codImp String?

  codRga String?
  rubro  RubroConceptoCaja? @relation(fields: [codRga], references: [codigo])

  // Original de MaxiRest (Diego 29/10/2026): nombre / tipo / codRga se pueden editar en
  // Lazarillo (editadoEnLazarillo) y el import del maestro ya no los pisa.
  nombreMaxirest     String?
  tipoMaxirest       String?
  codRgaMaxirest     String?
  editadoEnLazarillo Boolean @default(false)

  compras         Compra[] @relation("conceptoPrincipal")
  comprasManuales Compra[] @relation("conceptoManual")

  @@index([codRga])
  @@map("conceptos_caja")
}

model RubroArticulo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique
  nombre     String
  color      String?
  grupoNro   String?
  grupoCol   String?
  grupoFot   String?
  excluyeInf Boolean?
  evento     String?
  deliAct    Boolean?
  eveFor     String?
  eveForm    String?
  eveFormH   String?
  discont    Decimal?
  fechaUpda  DateTime?
  modoVista  String?

  subrubros SubrubroArticulo[]
  articulos Articulo[]

  @@map("rubros_articulo")
}

model SubrubroArticulo {
  id        Int       @id @default(autoincrement())
  codigo    String    @unique
  nombre    String
  deliAct   Boolean?
  eveFor    String?
  eveForm   String?
  eveFormH  String?
  fechaUpda DateTime?

  codRua String?
  rubro  RubroArticulo? @relation(fields: [codRua], references: [codigo])

  articulos Articulo[]

  @@map("subrubros_articulo")
}

model Articulo {
  codigo  String   @id
  nombre  String
  precio1 Decimal?
  precio2 Decimal?
  precio3 Decimal?
  precio4 Decimal?

  codRua   String?
  codSua   String?
  rubro    RubroArticulo?    @relation(fields: [codRua], references: [codigo])
  subrubro SubrubroArticulo? @relation(fields: [codSua], references: [codigo])

  detallesCompra DetalleCompra[]

  @@map("articulos")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String?
  razon     String?
  direccion String?
  localidad String?
  contacto  String?
  telefono  String?
  fax       String?
  celular   String?
  tipoIva   String?
  cuit      String?
  cbu       String?
  aliasCbu  String?
  diasVenc  Int?
  iva       Decimal?
  ivaDif    Decimal?
  email     String?
  observac  String?
  detPerc   String?

  // Informe 80 / vista Impagas: el proveedor cobra solo (débito automático,
  // se retiene de la liquidación, etc.) — sus facturas sin pago registrado no
  // cuentan como deuda. Lo marca el usuario desde el Panel.
  pagoAutomatico Boolean @default(false)

  compras        Compra[]
  detallesCompra DetalleCompra[]
  pagos          Pago[]

  @@map("proveedores")
}

// ─── TRANSACCIONALES ─────────────────────────────────────────────────────────

model Compra {
  rowId       String  @id
  comprobante String? // generado en ETL: COD_CPB + NUMERO1(4) + NUMERO2(8)

  codCga           String?
  concepto         String?
  fecha            DateTime?
  codigo           String? // código proveedor del ERP (texto)
  proveedor        String? // nombre proveedor del ERP (texto)
  detalle          String?
  observac         String?
  importe          Decimal?
  importeTrabajado Decimal? // = importe en Fase 1; campo para prorrateo en Fase 2
  impInt           Decimal?
  imputac          String?
  per1             Decimal?
  per2             Decimal?
  per3             Decimal?
  // Columnas del kit (26/10/2026), solo gastos varios (G) y sueldos (E):
  // fecha y caja del pago (vista financiera) y mes que liquida el sueldo (vista económica).
  fechaPago        DateTime?
  cajaPago         String?
  periodo          DateTime?
  // 'lazarillo' = cargada desde el Panel (Etapa 4); null = importada de MaxiRest.
  origen           String?

  // Overrides manuales — sobreviven re-importaciones
  importeManual  Decimal?
  fechaManual    DateTime?
  observacManual String?

  // Apertura de Gastos — ver docs/superpowers/specs/2026-08-19-apertura-gastos-design.md
  esDistribuido Boolean   @default(false)
  distribuidoEn DateTime?
  esBloqueado   Boolean   @default(false)

  distribuciones DistribucionApertura[]

  localId        Int?
  puntoDeVentaId Int?
  local          Local?        @relation(fields: [localId], references: [id])
  puntoDeVenta   PuntoDeVenta? @relation(fields: [puntoDeVentaId], references: [id])

  conceptoCodigo String?
  conceptoCaja   ConceptoCaja? @relation("conceptoPrincipal", fields: [conceptoCodigo], references: [codigo])

  conceptoCodigoManual String?
  conceptoCajaManual   ConceptoCaja? @relation("conceptoManual", fields: [conceptoCodigoManual], references: [codigo])

  proveedorId  Int?
  proveedorRef Proveedor? @relation(fields: [proveedorId], references: [id])

  // Apertura de Gastos a nivel proveedor cuando NO hay proveedorId real — texto
  // crudo del ERP normalizado (misma función que agrupa el árbol del pivot, ver
  // lib/text-normalize.ts). NULL cuando proveedorId no es null: en ese caso el
  // motor matchea por proveedorId, este campo no se usa ni se mantiene.
  proveedorTextoNormalizado String?

  // Concepto fijo por empleado: id de la regla (reglas_concepto_empleado) que puso
  // conceptoCodigoManual. NULL = lo puso una persona o no hay override.
  conceptoPorRegla Int?

  detalles DetalleCompra[]

  @@index([fecha])
  @@index([localId, puntoDeVentaId])
  @@index([comprobante])
  @@index([origen, localId, comprobante, codigo])
  @@index([puntoDeVentaId, comprobante, codigo])
  @@index([proveedorId, localId])
  @@map("compras")
}

model DetalleCompra {
  rowId String @id

  codPro      String?
  codCpb      String?
  numero1     String?
  numero2     String?
  comprobante String? // COD_CPB + NUMERO1(4) + NUMERO2(8) — FK lógica hacia compras

  fecha    DateTime?
  codigo   String? // id producto del ERP
  nombre   String?
  medida   String?
  cantidad Decimal?
  neto     Decimal?
  totalIns Decimal?
  ivaTot   Decimal?
  impNtTot Decimal?
  tasa     Decimal?
  iva      Decimal?
  impInt   Decimal?
  percep   Decimal?
  observac String?

  // Concepto de caja por línea — MaxiRest lo exporta en el 25 desde oct-2026
  // (COD_CGA / NOM_CGA, dos columnas nuevas al final). Base de la vista Insumos
  // agrupada por concepto.
  codCga String?
  nomCga String?

  // 'lazarillo' = línea de una factura cargada desde el Panel; null = del informe 25.
  origen String?

  compraId String?
  compra   Compra? @relation(fields: [compraId], references: [rowId])

  articuloCodigo String?
  articulo       Articulo? @relation(fields: [articuloCodigo], references: [codigo])

  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  localId Int?
  local   Local? @relation(fields: [localId], references: [id])

  @@index([comprobante])
  @@index([compraId])
  @@index([localId])
  @@index([codCga])
  @@index([origen, localId, comprobante, codPro])
  @@map("detalle_compras")
}

// Informe 80 de MaxiRest ("compras - detalle de pagos"): una fila por pago
// aplicado a un comprobante. Vínculo lógico con compras por
// (localId, puntoDeVentaId, comprobante, codPro) — un comprobante del 14 puede
// estar partido en varias filas (concepto + percepciones), así que el pago se
// cuelga del comprobante, no de una fila. Sin FK: igual que detalle_compras.
model Pago {
  rowId String @id

  // Comprobante pagado
  fecha       DateTime? // fecha de la factura
  codCpb      String?
  prefijo     String?
  numero      String?
  comprobante String?   // COD_CPB + PREFIJO(4) + NUMERO(8), mismo formato que compras.comprobante
  codPro      String?   // código proveedor del ERP (texto)
  proveedor   String?   // nombre proveedor del ERP (texto)
  total       Decimal?  // total del comprobante según el 80 (manda para el estado de pago)
  codCga      String?   // gasto vario: concepto de caja
  concepto    String?

  // El pago
  medio     String?   // PAGO: "CAJA MAYOR" | "BANCOS" | ...
  importe   Decimal?
  fechaPago DateTime?
  orden     String?   // número de orden de pago del ERP (una orden puede pagar varias facturas)
  secuencia Int       @default(1) // n-ésima fila idéntica (cuotas iguales en la misma orden)

  // Valores / banco — hoy MaxiRest los exporta en 0; se guardan por si se usan
  fechaVal  DateTime?
  numeroVal String?
  codBan    String?
  banco     String?
  impVal    Decimal?

  proveedorId  Int?
  proveedorRef Proveedor? @relation(fields: [proveedorId], references: [id])

  localId        Int?
  puntoDeVentaId Int?
  local          Local?        @relation(fields: [localId], references: [id])
  puntoDeVenta   PuntoDeVenta? @relation(fields: [puntoDeVentaId], references: [id])

  creadoEn DateTime @default(now())

  @@index([localId, puntoDeVentaId, comprobante, codPro])
  @@index([puntoDeVentaId, comprobante, codPro])
  @@index([fechaPago])
  @@index([proveedorId])
  @@map("pagos")
}

// Vista Impagas: comprobantes que el usuario pasó a mano a Impagas aunque
// tengan motivo para quedar excluidos (rubro oculto, pago automático, nota de
// crédito). Clave lógica igual que el vínculo compras ↔ pagos.
model ImpagaForzada {
  id             Int      @id @default(autoincrement())
  puntoDeVentaId Int
  comprobante    String
  codPro         String
  creadoEn       DateTime @default(now())

  @@unique([puntoDeVentaId, comprobante, codPro])
  @@map("impagas_forzadas")
}

// Pagos entre PDV por aperturas: el PDV destino de una apertura le paga su %
// al PDV origen (el que administra el fondo). Cada pago queda imputado a
// movimientos concretos (filas de compras aperturadas); lo no imputado queda a
// cuenta. referencia = ID de la transferencia, no se puede repetir.
model PagoInterno {
  id           Int      @id @default(autoincrement())
  pdvOrigenId  Int // el que cobra
  pdvDestinoId Int // el que paga
  fecha        DateTime @db.Date
  importe      Decimal  @db.Decimal(14, 2)
  medio        String
  referencia   String?  @unique
  creadoEn     DateTime @default(now())
  creadoPor    String?
  anuladoEn    DateTime? // anulada: no cuenta, sus imputaciones se borran y queda en el historial

  aplicaciones AplicacionPagoInterno[]
  eventos      EventoPagoInterno[]

  @@index([pdvDestinoId, pdvOrigenId])
  @@map("pagos_internos")
}

// Historial de cada orden de pago (creada, editada, imputada, imputación quitada, anulada).
model EventoPagoInterno {
  id       Int      @id @default(autoincrement())
  pagoId   Int
  tipo     String
  detalle  String?
  importe  Decimal? @db.Decimal(14, 2)
  usuario  String?
  creadoEn DateTime @default(now())

  pago PagoInterno @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@map("eventos_pago_interno")
}

model AplicacionPagoInterno {
  id          Int     @id @default(autoincrement())
  pagoId      Int
  compraRowId String
  importe     Decimal @db.Decimal(14, 2)

  pago PagoInterno @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@index([compraRowId])
  @@map("aplicaciones_pago_interno")
}

// Nómina de MaxiRest por PDV (archivo "000 - nomina" del kit). Se usa para
// mostrar el nombre completo de los empleados en los sueldos aperturados.
// Después se conecta con rrhh_empleados (base de la app) por PDV + código.
model Empleado {
  id             Int       @id @default(autoincrement())
  puntoDeVentaId Int
  codigo         String
  nombre         String?
  apellido       String?
  fechaBaja      DateTime? @db.Date
  actualizadoEn  DateTime  @default(now()) @updatedAt

  @@unique([puntoDeVentaId, codigo])
  @@map("empleados")
}

model Venta {
  rowId String @id

  turno            String?
  comprobant       String?
  hora             String?
  tipo             String?
  mesa             String?
  mozo             String?
  cub              String?
  cobro            String? // texto forma de cobro
  codCobro         String? // id forma de cobro
  importe          Decimal?
  importeTrabajado Decimal? // = importe en Fase 1; campo para prorrateo en Fase 2
  importeManual    Decimal?
  total            Decimal?
  descuento        Decimal?
  cliNombre        String?
  cliRazon         String?
  cliCut           String?
  fecha            DateTime?
  codSuc           String?
  nombreSuc        String?
  cupon            String?

  localId        Int?
  puntoDeVentaId Int?
  local          Local?        @relation(fields: [localId], references: [id])
  puntoDeVenta   PuntoDeVenta? @relation(fields: [puntoDeVentaId], references: [id])

  @@index([fecha])
  @@index([localId, puntoDeVentaId])
  @@map("ventas")
}

model FlujoCajaManual {
  id             Int     @id @default(autoincrement())
  localId        Int?
  puntoDeVentaId Int?
  anio           Int
  mes            Int
  monto          Decimal

  local        Local?        @relation(fields: [localId], references: [id])
  puntoDeVenta PuntoDeVenta? @relation(fields: [puntoDeVentaId], references: [id])

  // El índice real en DB es NULLS NOT DISTINCT (ver migración 20260723000100) — Prisma no
  // tiene sintaxis nativa para eso, por eso queda declarado acá como unique común (drift esperado).
  @@unique([localId, puntoDeVentaId, anio, mes])
  @@map("flujo_caja_manual")
}

// ─── APERTURA DE GASTOS ────────────────────────────────────────────────────

model ReglaApertura {
  id        Int    @id @default(autoincrement())
  nivel     String // 'concepto' en v1; 'proveedor' | 'registro' reservados para versiones futuras
  entidadId String // código de ConceptoCaja en v1

  // Origen: local/PDV desde el que se creó la regla. Misma semántica que
  // destinos_regla — origenPuntoDeVentaId seteado => ese PDV puntual; solo
  // origenLocalId => todo el local. La regla solo aplica a compras de su
  // origen (spec 2026-08-31, "Reglas de un PDV no se replican a otro").
  origenLocalId        Int?
  origenPuntoDeVentaId Int?

  modo               String // 'historico' | 'entre_fechas' | 'desde_adelante' | 'desde_atras'
  fechaDesde         DateTime?
  fechaHasta         DateTime?
  extremosInclusivos Boolean   @default(true)

  estado    String   @default("activa") // 'activa' | 'inactiva'
  creadoPor String?
  creadoEn  DateTime @default(now())

  origenLocal        Local?        @relation("reglaOrigenLocal", fields: [origenLocalId], references: [id])
  origenPuntoDeVenta PuntoDeVenta? @relation("reglaOrigenPdv", fields: [origenPuntoDeVentaId], references: [id])

  destinos       DestinoRegla[]
  distribuciones DistribucionApertura[]

  @@index([entidadId, nivel, origenLocalId, origenPuntoDeVentaId])
  @@map("reglas_apertura")
}

model DestinoRegla {
  id             Int     @id @default(autoincrement())
  reglaId        Int
  localId        Int?
  puntoDeVentaId Int?
  porcentaje     Decimal @db.Decimal(5, 2)

  regla        ReglaApertura @relation(fields: [reglaId], references: [id])
  local        Local?        @relation(fields: [localId], references: [id])
  puntoDeVenta PuntoDeVenta? @relation(fields: [puntoDeVentaId], references: [id])

  distribuciones DistribucionApertura[]

  @@index([reglaId])
  @@map("destinos_regla")
}

model DistribucionApertura {
  id               Int      @id @default(autoincrement())
  compraRowId      String
  reglaId          Int
  destinoId        Int
  importeOriginal  Decimal  @db.Decimal(14, 2)
  porcentaje       Decimal  @db.Decimal(5, 2)
  importeCalculado Decimal  @db.Decimal(14, 2)
  procesadoEn      DateTime @default(now())

  compra  Compra        @relation(fields: [compraRowId], references: [rowId], onDelete: Cascade)
  regla   ReglaApertura @relation(fields: [reglaId], references: [id])
  destino DestinoRegla  @relation(fields: [destinoId], references: [id])

  @@index([compraRowId])
  @@index([reglaId])
  @@index([destinoId])
  @@map("distribuciones_apertura")
}

// ─── AUDITORÍA ────────────────────────────────────────────────────────────────

model ImportLog {
  id      Int    @id @default(autoincrement())
  batchId String // uuid, uno por POST — correlaciona los archivos de un mismo import

  fileType    String? // ETLFileType; null si el archivo no llegó a detectarse
  fileName    String
  storagePath String?

  localId        Int?
  puntoDeVentaId Int?

  estado    String // 'ok' | 'error' | 'no_soportado'
  totalRows Int?
  created   Int?
  updated   Int?
  skipped   Int?

  errors       Json?   // ETLRowError[] tal cual los arma runETL
  skippedRows  Json?   // ETLSkippedRow[] tal cual
  // 'error': excepción de runETL, no llegó a haber report.
  // 'no_soportado': columnas no matchean ningún ETLFileType — nunca se llamó a runETL.
  errorMessage String?

  durationMs Int?

  triggeredBy String // user.id de requireAuthUser()
  creadoEn    DateTime @default(now())

  // Huella del archivo de Drive ("<modifiedTime>|<size>"): si no cambió desde la
  // última importación OK, se saltea sin descargarlo (Diego, 24/10/2026).
  driveFileId String?
  driveHuella String?

  @@index([batchId])
  @@index([driveFileId, creadoEn])
  @@index([fileType, creadoEn])
  @@index([creadoEn])
  @@map("import_logs")
}

// Block de notas del menú lateral (una nota por usuario).
model NotaUsuario {
  email         String   @id
  texto         String   @default("")
  actualizadoEn DateTime @default(now()) @updatedAt

  @@map("notas_usuario")
}

// Proyecciones de cierre de mes guardadas día a día (tooltip de Ingresos).
model ProyeccionIngreso {
  ambito     String // "<localId|*>/<pdvId|*>"
  anio       Int
  mes        Int
  corte      DateTime @db.Date
  metodo     String // "semanas" | "dias_mes"
  facturado  Decimal  @db.Decimal(16, 2)
  proyeccion Decimal  @db.Decimal(16, 2)
  creadoEn   DateTime @default(now())

  @@id([ambito, anio, mes, corte, metodo])
  @@map("proyecciones_ingresos")
}

// De qué esquema/PDV de Render (donde el kit sube los informes cada día) sale
// cada punto de venta del Panel. Ej: container/BAR → Ramos Mejía · Bar.
model RenderOrigen {
  id             Int     @id @default(autoincrement())
  esquema        String
  pdv            String
  localId        Int
  puntoDeVentaId Int
  activo         Boolean @default(true)

  @@unique([esquema, pdv])
  @@map("render_origenes")
}

// Corridas de la lectura desde Render en el servidor (botón "Actualizar ahora" o
// cron diario): sirve de candado (una sola a la vez) y de avance para la pantalla.
model RenderCorrida {
  id      Int       @id @default(autoincrement())
  inicio  DateTime  @default(now())
  fin     DateTime?
  estado  String // 'corriendo' | 'ok' | 'error'
  origen  String // 'boton' | 'cron'
  total   Int       @default(0)
  hechos  Int       @default(0)
  actual  String?
  resumen Json?

  @@index([inicio])
  @@map("render_corridas")
}

// Facturas cargadas desde el Panel (Etapa 4): lo que se cargó tal cual (payload
// del modal, con reparto por PDV y conceptos), para verla y editarla con el mismo
// formato de la carga. Las filas en compras / detalle_compras se rearman de acá.
model FacturaLazarillo {
  id            Int      @id @default(autoincrement())
  localId       Int
  comprobante   String
  codigo        String // código del proveedor (como compras.codigo)
  proveedorId   Int
  fecha         DateTime @db.Date
  total         Decimal  @db.Decimal(16, 2)
  payload       Json
  creadoPor     String?
  creadoEn      DateTime @default(now())
  actualizadoPor String?
  actualizadoEn DateTime @default(now()) @updatedAt

  @@unique([localId, comprobante, codigo])
  @@map("facturas_lazarillo")
}

// Actividad de cada usuario en el Panel (campanita): factura cargada / editada /
// eliminada, pago, regla… para volver rápido a lo último que se hizo.
model Actividad {
  id          Int      @id @default(autoincrement())
  tipo        String // 'factura' | 'pago' | 'regla' | …
  accion      String // 'creada' | 'editada' | 'eliminada'
  descripcion String
  refId       String? // para abrirlo: rowId de compras, id de pago, …
  localId     Int?
  usuario     String?
  datos       Json?
  creadoEn    DateTime @default(now())

  @@index([creadoEn])
  @@map("actividad")
}

// Gestor de medios de pago (27/10/2026): lista única para todo el Panel. Los pagos
// guardan el nombre (pagos_internos.medio); renombrar actualiza esos pagos.
model MedioPago {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  tipo     String   @default("otro") // caja | banco | tarjeta | otro
  pideId   Boolean  @default(false) // muestra el campo ID (nº de operación)
  activo   Boolean  @default(true)
  orden    Int      @default(0)
  creadoEn DateTime @default(now())

  @@map("medios_pago")
}

// Pagos a proveedores cargados en Lazarillo (27/10/2026). El pago cuelga de la factura
// entera (PDV + comprobante + código de proveedor, como el informe 80); lo no imputado
// queda a cuenta. Anular no borra: queda en el historial (anuladoEn).
model PagoProveedor {
  id         Int       @id @default(autoincrement())
  codPro     String
  pdvPagaId  Int // PDV que paga
  fecha      DateTime  @db.Date
  importe    Decimal   @db.Decimal(14, 2)
  medio      String // nombre de un medio del gestor (medios_pago)
  referencia String?
  creadoEn   DateTime  @default(now())
  creadoPor  String?
  anuladoEn  DateTime?
  anuladoPor String?

  aplicaciones AplicacionPagoProveedor[]
  eventos      EventoPagoProveedor[]

  @@index([codPro])
  @@map("pagos_proveedor")
}

model AplicacionPagoProveedor {
  id          Int     @id @default(autoincrement())
  pagoId      Int
  pdvId       Int
  comprobante String
  codPro      String
  importe     Decimal @db.Decimal(14, 2)

  pago PagoProveedor @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@index([pdvId, comprobante, codPro])
  @@map("aplicaciones_pago_proveedor")
}

model EventoPagoProveedor {
  id       Int      @id @default(autoincrement())
  pagoId   Int
  tipo     String // creado | imputado | desimputado | anulado
  detalle  String?
  importe  Decimal? @db.Decimal(14, 2)
  usuario  String?
  creadoEn DateTime @default(now())

  pago PagoProveedor @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@map("eventos_pago_proveedor")
}


// "Sin carga" (28/10/2026): un gasto de todos los meses que en ese PDV ya no va
// (clave "p:<proveedorId>" o "c:<concepto de caja>"). Se deshace borrando la fila.
model SinCargaDescarte {
  id        Int      @id @default(autoincrement())
  pdvId     Int
  clave     String
  nombre    String?
  creadoEn  DateTime @default(now())
  creadoPor String?

  @@unique([pdvId, clave])
  @@map("sin_carga_descartes")
}

// Comprobantes recibidos de ARCA ("Mis Comprobantes", CSV que sube el usuario) — 28/10/2026.
// Se cruzan con compras por CUIT del emisor + punto de venta + número: lo que falta cargar
// (Sin carga · ARCA) y lo que difiere (Corregir). Subir el mismo CSV de nuevo no duplica.
model ArcaComprobante {
  id            Int      @id @default(autoincrement())
  cuitReceptor  String
  cuitEmisor    String
  emisor        String?
  tipo          Int
  puntoVenta    Int
  numero        BigInt
  fecha         DateTime @db.Date
  cae           String?
  moneda        String?
  tipoCambio    Decimal? @db.Decimal(18, 6)
  neto          Decimal  @default(0) @db.Decimal(18, 2)
  noGravado     Decimal  @default(0) @db.Decimal(18, 2)
  exento        Decimal  @default(0) @db.Decimal(18, 2)
  otrosTributos Decimal  @default(0) @db.Decimal(18, 2)
  iva           Decimal  @default(0) @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  importadoEn   DateTime @default(now())
  importadoPor  String?

  @@unique([cuitEmisor, tipo, puntoVenta, numero])
  @@index([fecha])
  @@map("arca_comprobantes")
}

// Compras que MaxiRest ya no tiene (versión vieja de un gasto editado) — 28/10/2026.
model CompraHuerfana {
  rowId               String   @id
  puntoDeVentaId      Int
  fecha               DateTime? @db.Date
  comprobante         String?
  codigo              String?
  proveedor           String?
  concepto            String?
  importe             Decimal? @db.Decimal(18, 2)
  importeManualAntes  Decimal? @db.Decimal(18, 2)
  observacManualAntes String?
  motivo              String
  estado              String
  detectadaEn         DateTime @default(now())
  actualizadaEn       DateTime @default(now())

  @@index([puntoDeVentaId, estado])
  @@map("compras_huerfanas")
}

// Carga de empleados desde el Panel (28/10/2026): cabecera de un sueldo o adelanto cargado a
// mano; sus filas están en compras (rowId "emp-<id>-…", origen 'lazarillo'). Anular las borra.
model LiquidacionEmpleado {
  id             Int       @id @default(autoincrement())
  tipo           String // sueldo | adelanto
  puntoDeVentaId Int
  localId        Int
  empleadoCodigo String
  empleadoNombre String
  periodo        DateTime  @db.Date
  fechaPago      DateTime  @db.Date
  total          Decimal   @db.Decimal(14, 2)
  adelantos      Decimal   @default(0) @db.Decimal(14, 2)
  payload        Json
  creadoPor      String?
  creadoEn       DateTime  @default(now())
  anuladoEn      DateTime?
  anuladoPor     String?

  @@index([puntoDeVentaId, empleadoCodigo, periodo], map: "liquidaciones_empleado_pdv_empleado_periodo_idx")
  @@map("liquidaciones_empleado")
}

// Concepto fijo por empleado (29/10/2026): todo lo de un empleado va a un concepto de caja.
model ReglaConceptoEmpleado {
  id                   Int       @id @default(autoincrement())
  entidadId            String
  nombre               String?
  origenPuntoDeVentaId Int
  conceptoCodigo       String
  modo                 String
  fechaDesde           DateTime?
  fechaHasta           DateTime?
  extremosInclusivos   Boolean   @default(true)
  estado               String    @default("activa")
  creadoPor            String?
  creadoEn             DateTime  @default(now())

  @@index([origenPuntoDeVentaId, estado], map: "reglas_concepto_empleado_pdv_idx")
  @@map("reglas_concepto_empleado")
}
